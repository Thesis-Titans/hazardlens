# Database (PostgreSQL + PostGIS)
POSTGRES_USER=hazardlens
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hazardlens

# API
# In Docker Compose, use host 'db':
DATABASE_URL=postgresql+asyncpg://hazardlens:changeme@db:5432/hazardlens
# If running API directly on host (outside Docker, connecting to exposed db container):
# DATABASE_URL=postgresql+asyncpg://hazardlens:changeme@localhost:5432/hazardlens

# Secret key used for signing anonymous session tokens (NFR-12 session isolation)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# AI providers (each developer uses their own free keys)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://host.docker.internal:11434
